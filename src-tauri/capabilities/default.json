{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Fin's own commands, no core plugins",
  "windows": ["main"],
  "permissions": [
    "allow-get-data",
    "allow-set-language",
    "allow-add-account",
    "allow-update-account",
    "allow-delete-account",
    "allow-add-category",
    "allow-update-category",
    "allow-delete-category",
    "allow-add-category-rule",
    "allow-apply-category-rule",
    "allow-remove-category-rule",
    "allow-list-rules",
    "allow-save-transaction",
    "allow-delete-transaction",
    "allow-set-counts-on",
    "allow-set-splits",
    "allow-set-account-balance",
    "allow-save-contract",
    "allow-delete-contract",
    "allow-import-camt053",
    "allow-undo-import",
    "allow-list-backups",
    "allow-create-backup",
    "allow-restore-backup",
    "allow-restore-backup-file",
    "allow-export-backup",
    "allow-set-budget",
    "allow-set-group-budget",
    "allow-copy-budgets-from-previous-year",
    "allow-copy-budget-month-to-next",
    "allow-budgets-from-average"
  ]
}
